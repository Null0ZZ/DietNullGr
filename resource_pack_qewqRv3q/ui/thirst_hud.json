{
    "blink_fade_in": {
        "anim_type": "alpha",
        "duration": 0.45,
        "easing": "linear",
        "from": 0.15,
        "next": "@thirst_hud.blink_fade_out",
        "to": 0.8
    },
    "blink_fade_out": {
        "anim_type": "alpha",
        "duration": 0.45,
        "easing": "linear",
        "from": 0.8,
        "next": "@thirst_hud.blink_fade_in",
        "to": 0.15
    },
    "main@hud.hud_screen": {
        "$screen_content": "thirst_hud.root",
        "absorbs_input": false,
        "button_mappings": [],
        "render_game_behind": true,
        "should_steal_mouse": false
    },
    "namespace": "thirst_hud",
    "root": {
        "type": "panel",
        "size": [
            "100%",
            "100%"
        ],
        "bindings": [
            {
                "binding_type": "global",
                "binding_name_override": "#visible",
                "binding_name": "#hud_visible"
            },
            {
                "binding_type": "global",
                "binding_name_override": "#alpha",
                "binding_name": "#hud_alpha"
            },
            {
                "binding_type": "global",
                "binding_name_override": "#propagateAlpha",
                "binding_name": "#hud_propagate_alpha"
            }
        ],
        "controls": [
            {
                "desktop_classic": {
                    "type": "panel",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "bindings": [
                        {
                            "binding_type": "global",
                            "binding_name_override": "#visible",
                            "binding_name": "#hud_visible_centered"
                        }
                    ],
                    "controls": [
                        {
                            "survival": {
                                "type": "panel",
                                "size": [
                                    "100%",
                                    "100%"
                                ],
                                "bindings": [
                                    {
                                        "binding_name_override": "#visible",
                                        "binding_name": "#show_survival_ui"
                                    }
                                ],
                                "controls": [
                                    {
                                        "bar@thirst_hud.thirst_bar": {
                                            "anchor_from": "bottom_middle",
                                            "anchor_to": "bottom_middle",
                                            "offset": [
                                                49.5,
                                                -45
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "desktop_touch": {
                    "type": "panel",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "bindings": [
                        {
                            "binding_type": "global",
                            "binding_name_override": "#visible",
                            "binding_name": "#hud_visible_centered_touch"
                        }
                    ],
                    "controls": [
                        {
                            "survival": {
                                "type": "panel",
                                "size": [
                                    "100%",
                                    "100%"
                                ],
                                "bindings": [
                                    {
                                        "binding_name_override": "#visible",
                                        "binding_name": "#show_survival_ui"
                                    }
                                ],
                                "controls": [
                                    {
                                        "bar@thirst_hud.thirst_bar": {
                                            "anchor_from": "bottom_middle",
                                            "anchor_to": "bottom_middle",
                                            "offset": [
                                                59.5,
                                                -45
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "pocket": {
                    "type": "panel",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "bindings": [
                        {
                            "binding_type": "global",
                            "binding_name_override": "#visible",
                            "binding_name": "#hud_visible_not_centered"
                        }
                    ],
                    "controls": [
                        {
                            "survival": {
                                "type": "panel",
                                "size": [
                                    "100%",
                                    "100%"
                                ],
                                "bindings": [
                                    {
                                        "binding_name_override": "#visible",
                                        "binding_name": "#show_survival_ui"
                                    }
                                ],
                                "controls": [
                                    {
                                        "bar@thirst_hud.thirst_bar": {
                                            "anchor_from": "top_right",
                                            "anchor_to": "top_right",
                                            "offset": [
                                                -2,
                                                12
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "thirst_bar": {
        "type": "panel",
        "size": [
            81,
            9
        ],
        "bindings": [
            {
                "binding_name_override": "#visible",
                "binding_condition": "always",
                "binding_name": "#thirst_hud.visible"
            }
        ],
        "controls": [
            {
                "slots": {
                    "type": "grid",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "size": [
                        80,
                        9
                    ],
                    "collection_name": "thirst_slots",
                    "grid_dimensions": [
                        10,
                        1
                    ],
                    "grid_item_template": "thirst_hud.thirst_slot",
                    "grid_rescaling_type": "none",
                    "maximum_grid_items": 10
                }
            }
        ]
    },
    "thirst_slot": {
        "type": "panel",
        "size": [
            8,
            9
        ],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "thirst_slots",
                "binding_condition": "always_when_visible"
            }
        ],
        "controls": [
            {
                "water_drop@thirst_hud.thirst_icon_style": {
                    "$background_texture": "textures/ui/thirst_nullgr/thirst_background",
                    "$blink_texture": "textures/ui/thirst_nullgr/thirst_blink",
                    "$flash_full_texture": "textures/ui/thirst_nullgr/thirst_flash_full",
                    "$flash_half_texture": "textures/ui/thirst_nullgr/thirst_flash_half",
                    "$full_texture": "textures/ui/thirst_nullgr/thirst_full",
                    "$half_texture": "textures/ui/thirst_nullgr/thirst_half",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.water_drop_style_visible"
                        }
                    ]
                }
            },
            {
                "square@thirst_hud.thirst_icon_style": {
                    "$background_texture": "textures/ui/thirst_nullgr/thirst_square_background",
                    "$blink_texture": "textures/ui/thirst_nullgr/thirst_square_blink",
                    "$flash_full_texture": "textures/ui/thirst_nullgr/thirst_square_flash_full",
                    "$flash_half_texture": "textures/ui/thirst_nullgr/thirst_square_flash_half",
                    "$full_texture": "textures/ui/thirst_nullgr/thirst_square_full",
                    "$half_texture": "textures/ui/thirst_nullgr/thirst_square_half",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.square_style_visible"
                        }
                    ]
                }
            }
        ]
    },
    "thirst_icon_style": {
        "type": "panel",
        "anchor_from": "left_middle",
        "anchor_to": "left_middle",
        "size": [
            9,
            9
        ],
        "$background_texture": "textures/ui/thirst_nullgr/thirst_background",
        "$blink_texture": "textures/ui/thirst_nullgr/thirst_blink",
        "$flash_full_texture": "textures/ui/thirst_nullgr/thirst_flash_full",
        "$flash_half_texture": "textures/ui/thirst_nullgr/thirst_flash_half",
        "$full_texture": "textures/ui/thirst_nullgr/thirst_full",
        "$half_texture": "textures/ui/thirst_nullgr/thirst_half",
        "controls": [
            {
                "background": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 0,
                    "texture": "$background_texture"
                }
            },
            {
                "full": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 1,
                    "texture": "$full_texture",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.full_visible"
                        }
                    ]
                }
            },
            {
                "half": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 1,
                    "texture": "$half_texture",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.half_visible"
                        }
                    ]
                }
            },
            {
                "critical_blink": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 2,
                    "alpha": "@thirst_hud.blink_fade_out",
                    "texture": "$blink_texture",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.critical_visible"
                        }
                    ]
                }
            },
            {
                "flash_full": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 3,
                    "texture": "$flash_full_texture",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.flash_full_visible"
                        }
                    ]
                }
            },
            {
                "flash_half": {
                    "type": "image",
                    "size": [
                        9,
                        9
                    ],
                    "layer": 3,
                    "texture": "$flash_half_texture",
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "thirst_slots",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "#thirst_hud.flash_half_visible"
                        }
                    ]
                }
            }
        ]
    }
}
