// __multiversion__
// 便秘使用持续水平波纹和短促提醒脉冲表现难以忍耐的憋闷感。

precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

// 强度、波纹幅度、纵向波纹数量和运动速度依次由 post_process.json 注入。
uniform vec4 EXTRA_VECTOR1;

void main()
{
    float strength = clamp(EXTRA_VECTOR1.x, 0.0, 1.0);
    float waveAmplitude = EXTRA_VECTOR1.y;
    float waveFrequency = EXTRA_VECTOR1.z;
    float motionSpeed = EXTRA_VECTOR1.w;
    float motionTime = TIME * motionSpeed;

    // 每 1.5 秒用同一波纹场完成一次轻抬和短回弹，提醒结束后平滑回到持续波动。
    float reminderTime = mod(motionTime, 1.5);
    float reminderRise = smoothstep(0.0, 0.08, reminderTime);
    float reminderFall = 1.0 - smoothstep(0.32, 0.50, reminderTime);
    float reminderEnvelope = reminderRise * reminderFall;
    float reminderBounce = sin(reminderTime * 12.5663706) * reminderEnvelope;
    float strainAmount = 0.84 + 0.16 * reminderEnvelope;

    // 四个波形横跨屏幕宽度并只推动纵向采样，使画面中的水平边缘呈现波浪线。
    float wavePhase = uv.x * 6.2831853 * waveFrequency + motionTime * 0.70 +
        reminderBounce * 0.18 * strength;
    float verticalWave = (
        sin(wavePhase) + sin(wavePhase * 2.0 - motionTime * 0.85) * 0.20
    ) * waveAmplitude * strength * strainAmount;

    // 满强度仅纵向内缩 1.5%，覆盖 1.2% 的最大波纹位移并避免边缘拉丝。
    float verticalInset = 0.015 * strength;
    vec2 sampleUv = uv;
    sampleUv.y = (sampleUv.y - 0.5) * (1.0 - verticalInset * 2.0) + 0.5;
    sampleUv.y += verticalWave;
    sampleUv = clamp(sampleUv, vec2(0.0), vec2(1.0));

    gl_FragColor = texture(TEXTURE_0, sampleUv);
}
