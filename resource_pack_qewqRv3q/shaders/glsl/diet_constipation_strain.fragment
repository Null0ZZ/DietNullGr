// __multiversion__
// 便秘使用多道水平扭曲带表现波纹本身持续颤动的憋闷感。

precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

// 强度、波纹幅度、水平波纹数量和运动速度依次由 post_process.json 注入。
uniform vec4 EXTRA_VECTOR1;

void main()
{
    float strength = clamp(EXTRA_VECTOR1.x, 0.0, 1.0);
    float waveAmplitude = EXTRA_VECTOR1.y;
    float waveFrequency = EXTRA_VECTOR1.z;
    float motionSpeed = EXTRA_VECTOR1.w;
    float motionTime = TIME * motionSpeed;

    // 四道水平扭曲带分布在不同高度，带外像素保持原位，避免整个画面跟随波纹移动。
    float bandCoordinate = fract(uv.y * waveFrequency);
    float bandDistance = abs(bandCoordinate - 0.5);
    float bandMask = 1.0 - smoothstep(0.10, 0.32, bandDistance);
    float screenEdgeMask = smoothstep(0.0, 0.04, uv.y) *
        (1.0 - smoothstep(0.96, 1.0, uv.y));
    bandMask *= screenEdgeMask;
    float bandIndex = floor(uv.y * waveFrequency);
    float bandSeed = bandIndex * 1.91;

    // 每轮先让波纹连续颤动一阵，再进入缓和期；包络只改变波纹本身，不叠加整屏偏移。
    float strainEpisodeTime = mod(motionTime, 5.2);
    float strainEpisodeRise = smoothstep(0.0, 0.35, strainEpisodeTime);
    float strainEpisodeFall = 1.0 - smoothstep(2.60, 3.20, strainEpisodeTime);
    float strainEpisodeEnvelope = strainEpisodeRise * strainEpisodeFall;
    // 同一个颤动信号直接调制所有波纹的频率和振幅，使整阵波纹同步收紧、放松和起伏。
    float tremorSignal = sin(motionTime * 8.0) * strainEpisodeEnvelope;
    float modulatedWaveFrequency = 3.0 * (1.0 + tremorSignal * 0.16);
    float modulatedWaveAmplitude = waveAmplitude * (
        0.78 + strainEpisodeEnvelope * 0.10 + tremorSignal * 0.18
    );

    // 每道波纹横跨屏幕宽度；颤动只参与波纹公式，不改变画面基准位置。
    float wavePhase = uv.x * 6.2831853 * modulatedWaveFrequency +
        motionTime * 0.60 + bandSeed;
    float waveShape = sin(wavePhase) +
        sin(wavePhase * 2.0 - motionTime * 0.75 + bandSeed * 0.70) * 0.20;
    float verticalDistortion = waveShape * modulatedWaveAmplitude * strength *
        bandMask;

    vec2 sampleUv = uv;
    sampleUv.y = clamp(uv.y + verticalDistortion, 0.0, 1.0);

    gl_FragColor = texture(TEXTURE_0, sampleUv);
}
