// __multiversion__
// 发烧使用持续橙红渐晕，并让颜色与遮罩半径同步呼吸表现发热压迫感。

precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

// 生命周期强度、渐晕覆盖、中心暖色和呼吸周期依次由疾病模块动态注册的参数注入。
uniform vec4 EXTRA_VECTOR1;

void main()
{
    float strength = clamp(EXTRA_VECTOR1.x, 0.0, 1.0);
    float vignetteIntensity = EXTRA_VECTOR1.y;
    float centerWarmth = EXTRA_VECTOR1.z;
    float breathPeriod = EXTRA_VECTOR1.w;

    // 每轮前 42% 较快压深并向中心收紧，后 58% 较慢回落并向外舒张。
    float breathPhase = mod(TIME, breathPeriod) / breathPeriod;
    float deepening = smoothstep(0.0, 0.42, breathPhase);
    float relaxing = 1.0 - smoothstep(0.42, 1.0, breathPhase);
    float breathingAmount = deepening * relaxing;

    vec3 orangeRed = vec3(0.9411765, 0.2901961, 0.1333333);
    vec3 deepRed = vec3(0.4549020, 0.0666667, 0.0509804);
    vec3 feverColor = mix(orangeRed, deepRed, breathingAmount);

    vec3 sourceColor = texture(TEXTURE_0, uv).rgb;
    vec2 centeredUv = uv * 2.0 - vec2(1.0);
    float radialDistance = length(centeredUv * vec2(1.0, 1.10));
    float vignetteInnerRadius = mix(0.50, 0.30, breathingAmount);
    float vignetteOuterRadius = mix(1.14, 0.96, breathingAmount);
    float vignetteMask = smoothstep(vignetteInnerRadius, vignetteOuterRadius, radialDistance);

    // 中心只增加少量暖色通道而不压暗；覆盖强度不参与呼吸，舒张阶段的屏幕边缘仍保持渐晕。
    float centerMask = 1.0 - vignetteMask;
    vec3 warmedColor = clamp(
        sourceColor + vec3(centerWarmth, centerWarmth * 0.18, 0.0) * strength * centerMask,
        vec3(0.0),
        vec3(1.0)
    );
    float vignetteAmount = vignetteMask * vignetteIntensity * strength;
    vec3 sceneColor = mix(warmedColor, feverColor, vignetteAmount);

    gl_FragColor = vec4(sceneColor, 1.0);
}
