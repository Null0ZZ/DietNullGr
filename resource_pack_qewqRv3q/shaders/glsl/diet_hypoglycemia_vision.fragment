// __multiversion__
// 低血糖后期使用单次全屏采样制造柔化、晃动双影和短促下坠感。

precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

// strength、柔化偏移、重影偏移和摆动速度依次由 post_process.json 注入。
uniform vec4 EXTRA_VECTOR1;

void main()
{
    float strength = clamp(EXTRA_VECTOR1.x, 0.0, 1.0);
    float blurOffset = EXTRA_VECTOR1.y;
    float ghostOffset = EXTRA_VECTOR1.z;
    float swaySpeed = EXTRA_VECTOR1.w;

    // 六秒主摆动负责失衡感，较快轻颤避免重影像固定描边，窄脉冲模拟突然发虚下坠。
    float slowSway = sin(TIME * swaySpeed);
    float tremor = sin(TIME * swaySpeed * 4.25 + slowSway * 1.5);
    float faintPulse = pow(0.5 + 0.5 * sin(TIME * swaySpeed - 1.5708), 6.0);

    vec3 sourceColor = texture(TEXTURE_0, uv).rgb;
    vec3 blurredColor = sourceColor * 0.40;
    blurredColor += texture(TEXTURE_0, uv + vec2(blurOffset, 0.0)).rgb * 0.15;
    blurredColor += texture(TEXTURE_0, uv - vec2(blurOffset, 0.0)).rgb * 0.15;
    blurredColor += texture(TEXTURE_0, uv + vec2(0.0, blurOffset)).rgb * 0.15;
    blurredColor += texture(TEXTURE_0, uv - vec2(0.0, blurOffset)).rgb * 0.15;

    float separation = 0.55 + abs(slowSway) * 0.25 + faintPulse * 0.15;
    float horizontalWobble = slowSway * 0.10 + tremor * 0.05;
    float verticalWobble = cos(TIME * swaySpeed * 0.75) * 0.20 +
        sin(TIME * swaySpeed * 3.25) * 0.12 + faintPulse * 0.20;
    // 两层重影不完全对称，既会分离和合拢，也会一起晃动；最大水平偏移仍小于 ghost_offset。
    vec2 positiveGhostOffset = ghostOffset * vec2(
        separation + horizontalWobble,
        verticalWobble
    );
    vec2 negativeGhostOffset = ghostOffset * vec2(
        -separation + horizontalWobble,
        -verticalWobble * 0.70
    );
    vec3 positiveGhostColor = texture(TEXTURE_0, uv + positiveGhostOffset).rgb;
    vec3 negativeGhostColor = texture(TEXTURE_0, uv + negativeGhostOffset).rgb;
    vec3 ghostedColor = blurredColor * 0.65 + positiveGhostColor * 0.20 + negativeGhostColor * 0.15;

    gl_FragColor = vec4(mix(sourceColor, ghostedColor, strength), 1.0);
}
