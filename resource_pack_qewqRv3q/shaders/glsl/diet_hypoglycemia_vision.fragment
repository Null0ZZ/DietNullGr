// __multiversion__
// 低血糖后期使用单次全屏后处理制造动态模糊、剧烈晃动双影和呼吸式濒晕黑边。

precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

// 强度、柔化偏移、重影偏移和摆动速度依次由疾病模块动态注册的参数注入。
uniform vec4 EXTRA_VECTOR1;

// 每次呼吸用约 1.6 秒收黑、1.6 秒放松，三次呼吸逐步逼近完全濒晕。
float breathingBlackout(float episodeTime)
{
    float breathWave = 0.5 - 0.5 * cos(episodeTime * 1.9634954);
    float breathEscalation = mix(0.78, 1.0, smoothstep(0.0, 8.0, episodeTime));
    float breathingAmount = mix(0.42, 1.0, pow(breathWave, 0.72));
    return breathingAmount * breathEscalation;
}

void main()
{
    float strength = clamp(EXTRA_VECTOR1.x, 0.0, 1.0);
    float baseBlurOffset = EXTRA_VECTOR1.y;
    float ghostOffset = EXTRA_VECTOR1.z;
    float swaySpeed = EXTRA_VECTOR1.w;

    // 单段发作整体渐入、连续呼吸三次后再整体渐出，期间黑边始终不会退回到零。
    float faintCycle = mod(TIME, 20.0);
    float blackoutEpisode = smoothstep(0.75, 2.35, faintCycle) * (
        1.0 - smoothstep(10.35, 11.95, faintCycle)
    );
    float episodeTime = clamp(faintCycle - 0.75, 0.0, 9.60);
    float breathingAmount = breathingBlackout(episodeTime);
    float blackoutPulse = blackoutEpisode * breathingAmount;

    // 呼吸波谷只缓解症状而不清空，避免连续发作被切成数次互不相干的闪黑。
    float recoveryWindow = blackoutEpisode * (1.0 - breathingAmount) * 0.65;

    // 发作期仍持续改变模糊量，避免画面只在“模糊”和“清晰”两个固定状态间切换。
    float blurPulse = 0.5 + 0.5 * sin(
        TIME * swaySpeed * 0.75 + sin(TIME * swaySpeed * 0.31) * 1.40
    );
    float symptomAmount = (0.68 + blurPulse * 0.32) * (1.0 - recoveryWindow);
    float blurOffset = baseBlurOffset * (0.45 + blurPulse * 0.55) * symptomAmount;

    vec3 sourceColor = texture(TEXTURE_0, uv).rgb;
    vec3 blurredColor = sourceColor * 0.28;
    blurredColor += texture(TEXTURE_0, uv + vec2(blurOffset, 0.0)).rgb * 0.18;
    blurredColor += texture(TEXTURE_0, uv - vec2(blurOffset, 0.0)).rgb * 0.18;
    blurredColor += texture(TEXTURE_0, uv + vec2(0.0, blurOffset)).rgb * 0.18;
    blurredColor += texture(TEXTURE_0, uv - vec2(0.0, blurOffset)).rgb * 0.18;

    // 两组非整倍频横向振动形成不规则快速摇晃，双影间距始终足够大，避免退化成轻微描边。
    float ghostScale = (0.60 + blurPulse * 0.40) * symptomAmount;
    float shakeX = sin(TIME * swaySpeed * 3.20) * 0.65 +
        sin(TIME * swaySpeed * 5.70 + sin(TIME * swaySpeed * 0.90)) * 0.35;
    float shakeY = cos(TIME * swaySpeed * 2.70) * 0.18 +
        sin(TIME * swaySpeed * 6.30) * 0.08;
    float separation = 0.75 + sin(TIME * swaySpeed * 1.50) * 0.20;
    vec2 positiveGhostOffset = ghostOffset * vec2(
        shakeX + separation,
        shakeY
    ) * ghostScale;
    vec2 negativeGhostOffset = ghostOffset * vec2(
        shakeX - separation,
        -shakeY * 0.70
    ) * ghostScale;
    vec3 positiveGhostColor = texture(TEXTURE_0, uv + positiveGhostOffset).rgb;
    vec3 negativeGhostColor = texture(TEXTURE_0, uv + negativeGhostOffset).rgb;
    vec3 ghostedColor = blurredColor * 0.30 + positiveGhostColor * 0.45 + negativeGhostColor * 0.25;

    vec3 symptomColor = mix(sourceColor, ghostedColor, strength * symptomAmount);

    // 上下方向比左右更快收紧，形成视野真正向中心塌缩的濒晕感。
    vec2 centeredUv = uv * 2.0 - vec2(1.0);
    vec2 vignetteUv = centeredUv * vec2(1.0, 1.18);
    float severity = pow(strength, 0.35);
    float vignetteInnerRadius = mix(0.50, 0.22, severity * blackoutPulse);
    float vignetteMask = smoothstep(vignetteInnerRadius, 0.86, length(vignetteUv));
    float vignetteStrength = 0.98 * pow(strength, 0.22);
    float vignetteAmount = vignetteMask * pow(blackoutPulse, 0.80) * vignetteStrength;
    float centerDimming = 0.20 * pow(strength, 0.45) * pow(blackoutPulse, 1.40);
    symptomColor *= 1.0 - centerDimming;

    gl_FragColor = vec4(mix(symptomColor, vec3(0.0), vignetteAmount), 1.0);
}
